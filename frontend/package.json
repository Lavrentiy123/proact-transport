{
  "name": "proact-transport-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:stub": "node scripts/mock-backend.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node scripts/contract-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "ui-metrics": "node scripts/ui-metrics.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.21.3"
  }
}
