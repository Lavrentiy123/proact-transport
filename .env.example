# Образец .env для docker compose (скопируйте в .env и поменяйте, если порт занят).
BACKEND_PORT=8000
NDTP_PORT=9201
ML_CORE_PORT=8001
FRONTEND_PORT=3000
EMULATOR_API_PORT=18080
# Replay исторического дня: начальный момент и скорость (во сколько раз быстрее реального времени)
REPLAY_START_AT=2026-01-06T07:00:00
REPLAY_SPEED=10
# Официальный эмулятор (профиль emulator): backend сам настраивает его через REST
# EMULATOR_API=http://ndtp-emulator:18080
# EMULATOR_MODE=auto
