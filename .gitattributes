# LF везде: код собирается и запускается в Linux-контейнерах (start.sh с CRLF не запустится)
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cbm binary
*.onnx binary
*.pdf binary
*.jpg binary
*.png binary
*.pmtiles binary

# Данные оргов храним байт в байт (без нормализации переводов строк)
data/** -text
# Образ эмулятора NDTP (134 МБ > лимита GitHub 100 МБ) — через Git LFS
data/*.tar filter=lfs diff=lfs merge=lfs -text
